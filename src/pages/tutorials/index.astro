---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TutorialCard from '../../components/TutorialCard.astro';

const allTutorials = await getCollection('tutorials', ({ data }) => !data.draft);

// Fixed tier order (not alphabetical) so the page always reads easiest to
// hardest. Tutorials without a difficulty fall into "Uncategorized" at the
// end, same fallback pattern used for category grouping elsewhere on the site.
const tierOrder = ['beginner', 'intermediate', 'advanced', 'uncategorized'] as const;
const tierLabels: Record<(typeof tierOrder)[number], string> = {
  beginner: 'Beginner',
  intermediate: 'Intermediate',
  advanced: 'Advanced',
  uncategorized: 'Uncategorized',
};

const groups = tierOrder
  .map((tier) => ({
    tier,
    label: tierLabels[tier],
    tutorials: allTutorials
      .filter((t) => (t.data.difficulty ?? 'uncategorized') === tier)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
  }))
  .filter((group) => group.tutorials.length > 0);
---
<BaseLayout
  title="All tutorials"
  description="Every hands-on tutorial on Tutorial Hub, grouped by difficulty."
>
  <section class="tutorials-page">
    <div class="inner">
      <h1>All tutorials</h1>

      {
        groups.map(({ tier, label, tutorials }) => (
          <div class="tier-group" data-reveal>
            <h2>
              <span class={`tier-dot tier-dot-${tier}`} aria-hidden="true" />
              {label}
            </h2>
            <div class="grid">
              {tutorials.map((tutorial) => (
                <TutorialCard
                  slug={tutorial.id}
                  title={tutorial.data.title}
                  description={tutorial.data.description}
                  pubDate={tutorial.data.pubDate}
                  difficulty={tutorial.data.difficulty}
                />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .tutorials-page {
    padding: var(--space-8) 0 var(--space-9);
  }

  .inner {
    max-width: var(--content-width);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-8);
  }

  .tier-group + .tier-group {
    margin-top: var(--space-8);
  }

  h2 {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-5);
    color: var(--text-muted);
  }

  .tier-dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .tier-dot-beginner {
    background: var(--accent-2);
  }

  .tier-dot-intermediate {
    background: var(--accent);
  }

  .tier-dot-advanced {
    background: var(--text);
  }

  .tier-dot-uncategorized {
    background: var(--text-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

---
// A standalone "link in bio" page modeled on LittleLink (https://github.com/sethcottle/littlelink),
// a lightweight, dependency-free Linktree alternative. Deliberately bypasses BaseLayout (no site
// header/nav/footer) to match LittleLink's own minimal, single-purpose page philosophy — this is
// meant to be shared directly as a bio link, not browsed as part of the site's tutorial content.
//
// Button colors below are taken directly from LittleLink's own css/brands.css so each button
// matches its real brand (LittleLink itself doesn't ship a Credly style, so it uses the same
// neutral white/black fallback LittleLink uses for other unbranded/lesser-known services).
import '../styles/global.css';

const links = [
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/ecellsworth/',
    bg: '#2867b2',
    text: '#ffffff',
    border: 'none',
  },
  {
    label: 'Follow on X',
    href: 'https://x.com/creativednim',
    bg: '#000000',
    text: '#ffffff',
    border: '1px solid #ffffff',
  },
  {
    label: 'GitHub',
    href: 'https://github.com/ecellsworth',
    bg: '#000000',
    text: '#ffffff',
    border: '1px solid #ffffff',
  },
  {
    label: 'Credly Badges',
    href: 'https://www.credly.com/users/ecellsworth',
    bg: '#ffffff',
    text: '#000000',
    border: '1px solid #000000',
  },
  {
    label: 'Tutorial Hub',
    href: 'https://ecellsworth.github.io/',
    bg: '#2457F5',
    text: '#ffffff',
    border: '1px solid #ffffff',
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://ecellsworth.github.io/links/" />
    <title>ecellsworth · Links</title>
    <meta name="description" content="Find ecellsworth on LinkedIn, X, GitHub, Credly, and Tutorial Hub." />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="ecellsworth · Links" />
    <meta property="og:description" content="Find ecellsworth on LinkedIn, X, GitHub, Credly, and Tutorial Hub." />
    <meta property="og:url" content="https://ecellsworth.github.io/links/" />

    <script is:inline>
      // Same theme-init used sitewide, so this page matches whatever theme
      // was last chosen elsewhere on the site (falls back to system preference).
      const stored = localStorage.getItem('theme');
      const theme = stored ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body>
    <main class="container">
      <img
        class="avatar"
        src="https://github.com/ecellsworth.png"
        srcset="https://github.com/ecellsworth.png?size=256 2x"
        alt="ecellsworth"
        width="112"
        height="112"
        loading="eager"
      />

      <h1>ecellsworth</h1>
      <p class="bio">Builder of Tutorial Hub. Find me around the web below.</p>

      <nav class="button-stack" aria-label="Links">
        {
          links.map((link) => (
            <a
              class="button"
              href={link.href}
              target="_blank"
              rel="noopener"
              style={`--button-background:${link.bg}; --button-text:${link.text}; --button-border:${link.border};`}
            >
              {link.label === 'LinkedIn' && (
                <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.119 20.452H3.553V9h3.566v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
              )}
              {link.label === 'Follow on X' && (
                <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
              )}
              {link.label === 'GitHub' && (
                <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                </svg>
              )}
              {link.label === 'Credly Badges' && (
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="8" r="6" />
                  <path d="M8.5 13.5 7 22l5-3 5 3-1.5-8.5" />
                </svg>
              )}
              {link.label === 'Tutorial Hub' && (
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" />
                  <line x1="2" y1="12" x2="22" y2="12" />
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                </svg>
              )}
              {link.label}
            </a>
          ))
        }
      </nav>

      <footer>
        <a href="/">Back to Tutorial Hub</a>
      </footer>
    </main>
  </body>
</html>

<style>
  body {
    display: flex;
    justify-content: center;
    min-height: 100vh;
  }

  .container {
    width: 100%;
    max-width: 26rem;
    box-sizing: border-box;
    padding: var(--space-9) var(--space-5) var(--space-8);
    text-align: center;
  }

  .avatar {
    width: 7rem;
    height: 7rem;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto var(--space-5);
    border: 3px solid var(--border);
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .bio {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: var(--space-7);
  }

  .button-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 1.25rem;
    margin-bottom: var(--space-4);
    border-radius: var(--radius-md);
    background-color: var(--button-background, transparent);
    color: var(--button-text, var(--text));
    border: var(--button-border, none);
    font-size: 1.0625rem;
    font-weight: 700;
    text-decoration: none;
    line-height: 1.3;
    box-sizing: border-box;
    transition: filter var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .button:hover {
    filter: brightness(90%);
    transform: translateY(-1px);
  }

  .button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .button:hover {
      transform: none;
    }
  }

  .icon {
    width: 1.25rem;
    height: 1.25rem;
    margin-right: 0.6rem;
    flex-shrink: 0;
  }

  footer {
    margin-top: var(--space-7);
    font-size: 0.8125rem;
  }

  footer a {
    color: var(--text-muted);
  }
</style>

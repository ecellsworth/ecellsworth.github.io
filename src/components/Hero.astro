---
// Full-bleed, theme-switched sky hero. Replaces the old rounded "sky card"
// (a single scene that spun around on theme change) with two separate,
// user-provided animations — DaySkyScene and NightSkyScene — swapped via
// the same :root[data-theme] attribute every themed element on the site
// already uses. Both scenes share this exact wrapper, so they render at
// identical size/position and switching themes never shifts the layout.
import DaySkyScene from './DaySkyScene.astro';
import NightSkyScene from './NightSkyScene.astro';
---
<section class="hero">
  <div class="scene-day">
    <DaySkyScene />
  </div>
  <div class="scene-night">
    <NightSkyScene />
  </div>

  <div class="scrim" aria-hidden="true"></div>

  <div class="content">
    <h1>Learn by building.</h1>
    <p class="subhead">Hands-on, no-fluff tutorials for shipping real things with modern AI tooling.</p>
    <a class="cta" href="/tutorials/">Browse tutorials</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: clamp(420px, 62vh, 640px);
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .hero {
      height: clamp(360px, 70vh, 520px);
    }
  }

  .scene-day,
  .scene-night {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .scene-day {
    display: block;
  }

  .scene-night {
    display: none;
  }

  :root[data-theme='dark'] .scene-day {
    display: none;
  }

  :root[data-theme='dark'] .scene-night {
    display: block;
  }

  /* --- Text overlay -------------------------------------------------------- */

  .scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(6, 10, 22, 0.08) 0%, rgba(6, 10, 22, 0.32) 55%, rgba(6, 10, 22, 0.6) 100%);
    pointer-events: none;
  }

  .content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-6) var(--space-5);
    color: #ffffff;
  }

  h1 {
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.3);
  }

  .subhead {
    margin-top: var(--space-4);
    max-width: 40rem;
    font-size: clamp(0.9375rem, 2vw, 1.1875rem);
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.6;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.3);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-6);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: #ffffff;
    font-weight: 600;
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .cta:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.22);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta:hover {
      transform: none;
    }
  }
</style>
